{
  // 组件库按标签名自动引入：模板写 wd-xxx 即加载对应组件，页面无需手写 import
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  // 页面路由表：数组第一项为启动页；login、search、detail 为普通栈页，不在底部 Tab 内
  "pages": [
    {
      "path": "pages/home/home",
      "style": {
        "navigationBarTitleText": "衡物",
        // 首页自绘顶栏搜索区，隐藏系统导航栏
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/category/category",
      "style": {
        "navigationBarTitleText": "分类"
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationBarTitleText": "搜索",
        // 搜索页自绘顶栏输入区，隐藏系统导航栏
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationBarTitleText": "商品详情",
        // 详情页自绘头图返回按钮，隐藏系统导航栏
        "navigationStyle": "custom"
      }
    },
    {
      // 确认订单：算价、选地址、创建订单
      "path": "pages/checkout/checkout",
      "style": {
        "navigationBarTitleText": "确认订单"
      }
    },
    {
      // 收银台：余额支付与渠道占位
      "path": "pages/pay/pay",
      "style": {
        "navigationBarTitleText": "收银台"
      }
    },
    {
      // 支付成功结果页
      "path": "pages/pay-result/pay-result",
      "style": {
        "navigationBarTitleText": "支付成功"
      }
    }
  ],
  // 全局默认导航栏与窗口背景
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "衡物",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F5F5"
  },
  // 底部四个原生 Tab；图标为 static/tab 下 PNG；选中色为品牌绿
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#2F6F5E",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "static/tab/tab-home.png",
        "selectedIconPath": "static/tab/tab-home-active.png"
      },
      {
        "pagePath": "pages/category/category",
        "text": "分类",
        "iconPath": "static/tab/tab-category.png",
        "selectedIconPath": "static/tab/tab-category-active.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tab/tab-cart.png",
        "selectedIconPath": "static/tab/tab-cart-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tab/tab-mine.png",
        "selectedIconPath": "static/tab/tab-mine-active.png"
      }
    ]
  }
}
