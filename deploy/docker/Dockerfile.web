# 质衡 Demo 前端构建 + Nginx（管理端 demo-ui + 商城 H5 demo-uni）
# 构建上下文：仓库根目录
# 可选：--build-arg VITE_GIT_SHA=<commit> 写入前端控制台版本行

ARG VITE_GIT_SHA=

FROM node:22-alpine AS build-ui
ARG VITE_GIT_SHA
ENV VITE_GIT_SHA=$VITE_GIT_SHA
WORKDIR /ui

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

COPY demo-ui/package.json demo-ui/pnpm-lock.yaml demo-ui/pnpm-workspace.yaml demo-ui/.npmrc ./
RUN pnpm install --frozen-lockfile

COPY demo-ui/ ./
RUN pnpm build:prod

FROM node:22-alpine AS build-h5
ARG VITE_GIT_SHA
ENV VITE_GIT_SHA=$VITE_GIT_SHA
WORKDIR /h5

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

COPY demo-uni/package.json demo-uni/pnpm-lock.yaml demo-uni/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY demo-uni/ ./
RUN pnpm build:h5

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build-ui /ui/dist /usr/share/nginx/html
# uni-app H5 产物目录：dist/build/h5
COPY --from=build-h5 /h5/dist/build/h5 /usr/share/nginx/html/h5

EXPOSE 5181
